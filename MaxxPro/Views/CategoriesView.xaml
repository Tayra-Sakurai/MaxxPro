<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaxxPro.Views.CategoriesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MaxxPro.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:te="using:MaxxPro.TemplatedElements"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TreeView
            x:Name="SpecialCategoryTreeView"
            ItemsSource="{x:Bind categoriesViewModel.LargeCategories, Mode=OneWay}"
            ItemTemplateSelector="{StaticResource SpecialTemplateSelectorForTreeView}"/>
        <Border
            Grid.Row="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8"
            BorderBrush="{StaticResource CardStrokeColorDefaultSolidBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Uid="LargeCategorySelect"
                    ItemsSource="{x:Bind categoryViewModel.LargeCategories, Mode=OneWay}"
                    SelectedItem="{x:Bind categoryViewModel.LargeCategory, Mode=TwoWay}"
                    DisplayMemberPath="Name"/>
                <ComboBox
                    x:Uid="MediumCategorySelect"
                    Grid.Column="1"
                    ItemsSource="{x:Bind categoryViewModel.MediumCategories, Mode=OneWay}"
                    SelectedItem="{x:Bind categoryViewModel.MediumCategory, Mode=TwoWay}"
                    DisplayMemberPath="Name"/>
                <te:ValidationTextBox
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    x:Uid="NameBox"
                    Property="Name"
                    Text="{x:Bind categoryViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ViewModel="{x:Bind categoryViewModel}"/>
            </Grid>
        </Border>
        <CommandBar
            Grid.Row="2"
            DefaultLabelPosition="Bottom">
            <AppBarButton
                Icon="Add"
                x:Uid="AddButton"
                Command="{x:Bind categoriesViewModel.AddCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=SpecialCategoryTreeView}"/>
            <AppBarButton
                Icon="Edit"
                x:Uid="EditButton"
                Command="{x:Bind categoriesViewModel.InvokeCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=SpecialCategoryTreeView}"/>
            <AppBarButton
                Icon="SyncFolder"
                x:Uid="SyncTableButton"
                Command="{x:Bind categoriesViewModel.LoadCommand}"/>
            <AppBarSeparator/>
            <AppBarButton
                Icon="Delete"
                x:Uid="DeleteButton"
                Command="{x:Bind categoryViewModel.RemoveCommand}"/>
            <AppBarButton
                Icon="Save"
                x:Uid="SaveButton"
                Command="{x:Bind categoryViewModel.UpdateCommand}"/>
            <AppBarButton
                Icon="Sync"
                x:Uid="SyncButton"
                Command="{x:Bind categoryViewModel.LoadCommand}"/>
        </CommandBar>
    </Grid>
</Page>
