<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MaxxPro.Views.ItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MaxxPro.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    xmlns:te="using:MaxxPro.TemplatedElements"
    xmlns:models="using:Caiman.Models"
    mc:Ignorable="d models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <tv:TableView
            ItemsSource="{x:Bind itemsViewModel.Items}"
            d:DataContext="{d:DesignInstance Type=models:Item}"
            AutoGenerateColumns="False"
            x:Name="ItemTable"
            IsReadOnly="True"
            SelectionUnit="Row"
            SelectionMode="Single">
            <tv:TableView.Columns>
                <tv:TableViewNumberColumn Binding="{Binding Id}" x:Uid="IdColumn"/>
                <tv:TableViewDateColumn Binding="{Binding Life}" x:Uid="LifeColumn"/>
                <tv:TableViewTextColumn Binding="{Binding Category.Parent.Parent.Name}" x:Uid="LargeCategoryColumn"/>
                <tv:TableViewTextColumn Binding="{Binding Category.Parent.Name}" x:Uid="MediumCategoryColumn"/>
                <tv:TableViewTextColumn Binding="{Binding Category.Name}" x:Uid="SmallCategoryColumn"/>
                <tv:TableViewTextColumn Binding="{Binding Name}" x:Uid="NameColumn" Width="*"/>
            </tv:TableView.Columns>
        </tv:TableView>

        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Margin="0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Uid="LargeCategorySelect"
                    DisplayMemberPath="Name"
                    SelectedItem="{x:Bind itemViewModel.LargeCategory, Mode=TwoWay}"
                    ItemsSource="{x:Bind itemViewModel.LargeCategories, Mode=OneWay}"/>

                <ComboBox
                    Grid.Column="1"
                    x:Uid="MediumCategorySelect"
                    DisplayMemberPath="Name"
                    SelectedItem="{x:Bind itemViewModel.MediumCategory, Mode=TwoWay}"
                    ItemsSource="{x:Bind itemViewModel.MediumCategories, Mode=OneWay}"/>

                <ComboBox
                    Grid.Column="2"
                    x:Uid="SmallCategorySelect"
                    DisplayMemberPath="Name"
                    SelectedItem="{x:Bind itemViewModel.SmallCategory, Mode=TwoWay}"
                    ItemsSource="{x:Bind itemViewModel.SmallCategories, Mode=OneWay}"/>

                <CalendarDatePicker
                    Grid.Column="3"
                    x:Uid="LifeSetter"
                    Date="{x:Bind itemViewModel.Date, Mode=TwoWay}"/>

                <te:ValidationTextBox
                    Text="{x:Bind itemViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Property="Name"
                    ViewModel="{x:Bind itemViewModel, Mode=OneWay}"
                    x:Uid="NameBox"
                    Grid.Row="1"
                    Grid.ColumnSpan="5"/>

                <TextBox
                    Text="{x:Bind itemViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    x:Uid="DescBox"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Grid.Row="2"
                    MaxHeight="76"
                    Grid.ColumnSpan="5"/>
            </Grid>
        </Border>

        <CommandBar
            Grid.Row="2"
            DefaultLabelPosition="Bottom">
            <AppBarButton
                Icon="Add"
                x:Uid="AddButton"
                Command="{x:Bind itemsViewModel.AddCommand}"/>
            <AppBarButton
                Icon="Edit"
                x:Uid="EditButton"
                Command="{x:Bind itemsViewModel.InvokeCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=ItemTable}"/>
            <AppBarButton
                Icon="SyncFolder"
                x:Uid="SyncTableButton"
                Command="{x:Bind itemsViewModel.LoadCommand}"/>
            <AppBarSeparator/>
            <AppBarButton
                Icon="Sync"
                x:Uid="SyncButton"
                Command="{x:Bind itemViewModel.LoadCommand}"/>
            <AppBarButton
                Icon="Delete"
                x:Uid="DeleteButton"
                Command="{x:Bind itemViewModel.RemoveCommand}"/>
            <AppBarButton
                Icon="Save"
                x:Uid="SaveButton"
                Command="{x:Bind itemViewModel.UpdateCommand}"/>
        </CommandBar>
    </Grid>
</Page>
