<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="MaxxPro.Templates.TreeViewTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MaxxPro.Templates"
    xmlns:models="using:Caiman.Models">

    <DataTemplate
        x:Key="LargeCategoryTemplate"
        x:DataType="models:LargeCategory">
        <TreeViewItem
            ItemsSource="{Binding Children}"
            Content="{Binding Name}"/>
    </DataTemplate>

    <DataTemplate
        x:Key="MediumCategoryTemplate"
        x:DataType="models:MediumCategory">
        <TreeViewItem
            ItemsSource="{Binding Children}"
            Content="{Binding Name}"/>
    </DataTemplate>

    <DataTemplate
        x:Key="SmallCategoryTemplate"
        x:DataType="models:SmallCategory">
        <TreeViewItem
            Content="{Binding Name}"/>
    </DataTemplate>

    <local:TreeViewTemplateSelector
        x:Key="SpecialTemplateSelectorForTreeView"
        LargeCategoryTemplate="{StaticResource LargeCategoryTemplate}"
        MediumCategoryTemplate="{StaticResource MediumCategoryTemplate}"
        SmallCategoryTemplate="{StaticResource SmallCategoryTemplate}"/>
</ResourceDictionary>
